# =============================================================================
# MasterJiEstates Backend — Production & Development Environment Template
# Copy this file to server/.env for local development or set in hosting provider
# =============================================================================

# Server Environment & Port
# Use "production" for live hosting, "development" for local work
NODE_ENV=development
PORT=5000

# Client Web Application URL (Allowed CORS Origin)
# Development: http://localhost:5173
# Production: https://masterjiestates.in
CLIENT_URL=http://localhost:5173

# Database Connection (MongoDB Atlas) - MANDATORY in production
# In production, server will refuse to start if MongoDB is unreachable
# Example: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/masterji_estates?retryWrites=true&w=majority
MONGODB_URI=

# JWT Authentication & Session Hardening
# In production, specify a 64+ char cryptographically random secret string
JWT_SECRET=your_jwt_secret_key_here

# Admin CLI Bootstrapping Master Key
# Used to authorize node scripts/seedAdmin.js
ADMIN_SEED_SECRET_KEY=your_admin_seed_secret_key_here

# Production Cookie Domain (e.g. .masterjiestates.in or leave blank for host-only cookies)
COOKIE_DOMAIN=

# Cloudinary Media Infrastructure (Direct Signed Uploads)
# Obtain from Cloudinary Dashboard: Settings -> Access Keys
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
CLOUDINARY_FOLDER=masterji_estates/properties
