{
  "name": "masterjiestates",
  "version": "1.0.0",
  "description": "MasterJiEstates — Full-lifecycle real estate brokerage and asset management platform",
  "private": true,
  "scripts": {
    "dev": "concurrently -n \"SERVER,CLIENT\" -c \"blue.bold,cyan.bold\" \"npm run dev:server\" \"npm run dev:client\"",
    "dev:client": "npm run dev --prefix client",
    "dev:server": "npm run dev --prefix server",
    "build:client": "npm run build --prefix client",
    "preview:client": "npm run preview --prefix client",
    "start:server": "npm run start --prefix server",
    "seed:server": "npm run seed --prefix server",
    "seed:properties": "npm run seed:properties --prefix server",
    "seed:admin": "npm run seed:admin --prefix server",
    "test:auth": "npm run test:auth --prefix server",
    "test:dashboard": "npm run test:dashboard --prefix server",
    "test:submission": "npm run test:submission --prefix server",
    "install:all": "npm install && npm install --prefix client && npm install --prefix server"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  },
  "keywords": [
    "real-estate",
    "brokerage",
    "property-management",
    "react",
    "express",
    "mongodb"
  ],
  "author": "MasterJiEstates Team",
  "license": "ISC"
}

