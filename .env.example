# =============================================================================
# MasterJiEstates — Root Environment Configuration Baseline
# Copy this file to .env or configure respective client/.env and server/.env
# =============================================================================

# -----------------------------------------------------------------------------
# Part 2 Baseline Variables (Active)
# -----------------------------------------------------------------------------
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173
VITE_API_BASE_URL=http://localhost:5000/api

# -----------------------------------------------------------------------------
# MongoDB Atlas Database Connection (Part 8 Active)
# -----------------------------------------------------------------------------
# Supply your MongoDB Atlas connection string to enable full database operations
MONGODB_URI=

# -----------------------------------------------------------------------------
# Authentication & Security Configuration (Part 9 Active)
# -----------------------------------------------------------------------------
# JWT Signing Secret (Generate 64+ char random string in production)
JWT_SECRET=masterjiestates_dev_secret_key_change_in_production_jwt

# Initial Admin CLI Provisioning Master Key
ADMIN_SEED_SECRET_KEY=masterjiestates_admin_seed_secret_key_2026

# Cookie Domain (Optional, e.g. .masterjiestates.in for cross-subdomain sessions)
COOKIE_DOMAIN=

# -----------------------------------------------------------------------------
# Future Architectural Variables (Reserved for Part 11, 14 - Not Active Yet)
# -----------------------------------------------------------------------------
# Cloudinary Media CDN Storage (Part 11)
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=

# Transactional Email Gateway (Part 14)
# EMAIL_SERVICE_API_KEY=
# EMAIL_FROM_ADDRESS=info@masterjiestates.in
